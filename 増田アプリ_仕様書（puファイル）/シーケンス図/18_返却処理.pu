@startuml 返却処理
autonumber
title 返却処理 (POST /borrows/borrows_active_list/<id>/return)

actor 管理者 as user
boundary "borrows/active.html" as ui
control "borrows/views.py" as flask
entity "Borrow / User / Book\n(models.py)" as model
database "SQLite\n(borrows / users / books)" as db

user -> ui : 「返却」ボタンをクリック
ui -> flask : POST /borrows/borrows_active_list/<id>/return
activate flask

flask -> model : Borrow.query.get_or_404(id)
activate model
model -> db : SELECT * FROM borrows WHERE borrows_id = ?
activate db
db --> model : レコード返却
deactivate db
model --> flask : Borrowオブジェクト
deactivate model

flask -> model : borrow.returned_at = date.today()
activate model
model -> db : UPDATE borrows SET returned_at = ?
db --> model : 更新完了
deactivate model

alt 返却日 > 返却予定日（滞納）
    flask -> model : User.query.get_or_404(borrow.user_id)
    activate model
    model -> db : SELECT * FROM users WHERE user_id = ?
    db --> model : レコード返却
    model --> flask : Userオブジェクト
    deactivate model

    flask -> model : user.overdue_count += 1
    activate model
    model -> db : UPDATE users SET overdue_count = ?
    db --> model : 更新完了
    deactivate model

    alt 滞納回数 >= 3
        flask -> model : user.blackflag = True
        activate model
        model -> db : UPDATE users SET blackflag = True
        db --> model : 更新完了
        model --> flask : ブラックリスト登録完了
        deactivate model
    end

    flask -> model : db.session.add(user)\ndb.session.commit()
    activate model
    model -> db : COMMIT
    db --> model : 完了
    deactivate model
end

flask -> model : Book.query.get_or_404(borrow.book_id)
activate model
model -> db : SELECT * FROM books WHERE book_id = ?
db --> model : レコード返却
model --> flask : Bookオブジェクト
deactivate model

flask -> model : book.stock += 1\ndb.session.add(book)\ndb.session.commit()
activate model
model -> db : UPDATE books SET stock = ?
activate db
db --> model : 更新完了
deactivate db
model --> flask : 完了
deactivate model

flask -> ui : redirect(url_for('borrows.borrows_active_list'))
ui --> user : 貸出中一覧へリダイレクト\n(「貸出ID:{id}が返却されました」表示)
deactivate flask

@enduml
