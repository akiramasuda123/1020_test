@startuml 新規貸出の登録
autonumber
title 新規貸出の登録 (GET・POST /borrows/borrows_new)

actor 管理者 as user
boundary "borrows/new.html" as ui
control "borrows/views.py" as flask
entity "Borrow / Book / User / BookGenre\n(models.py)" as model
database "SQLite\n(borrows / books / users / book_genres)" as db

== フォーム表示 ==
user -> ui : 「新規貸出」リンクをクリック
ui -> flask : GET /borrows/borrows_new
activate flask

flask -> model : User.query.filter(User.blackflag == False).all()
activate model
model -> db : SELECT * FROM users WHERE blackflag = False
activate db
db --> model : レコード一覧返却
deactivate db
model --> flask : Userオブジェクトのリスト\n(ブラックリスト除外)
deactivate model

flask -> model : Book.query.filter(Book.stock != 0).all()
activate model
model -> db : SELECT * FROM books WHERE stock != 0
activate db
db --> model : レコード一覧返却
deactivate db
model --> flask : Bookオブジェクトのリスト\n(在庫あり)
deactivate model

flask -> ui : render_template('borrows/new.html', form=form)\n※利用者・本の選択肢をformにセット
ui --> user : 貸出フォーム表示
deactivate flask

== 貸出処理 ==
user -> ui : 利用者・本・返却予定日を選択し「登録」
ui -> flask : POST /borrows/borrows_new
activate flask

flask -> model : Book.query.get_or_404(book_id)
activate model
model -> db : SELECT * FROM books WHERE book_id = ?
db --> model : レコード返却
model --> flask : Bookオブジェクト
deactivate model

flask -> model : book.stock -= 1\nbook.book_borrowed_count += 1\ndb.session.add(book)
activate model
model -> db : UPDATE books SET stock=?, book_borrowed_count=?
db --> model : 更新完了
deactivate model

flask -> model : User.query.get_or_404(user_id)
activate model
model -> db : SELECT * FROM users WHERE user_id = ?
db --> model : レコード返却
model --> flask : Userオブジェクト
deactivate model

flask -> model : user.user_borrowed_count += 1\ndb.session.add(user)
activate model
model -> db : UPDATE users SET user_borrowed_count=?
db --> model : 更新完了
deactivate model

flask -> model : BookGenre.query.get_or_404(book.genre_id)
activate model
model -> db : SELECT * FROM book_genres WHERE genre_id = ?
db --> model : レコード返却
model --> flask : BookGenreオブジェクト
deactivate model

flask -> model : bookgenre.genre_borrowed_count += 1\ndb.session.add(bookgenre)
activate model
model -> db : UPDATE book_genres SET genre_borrowed_count=?
db --> model : 更新完了
deactivate model

flask -> model : Borrow(user_id, book_id, due_date)\ndb.session.add(borrow)\ndb.session.commit()
activate model
model -> db : INSERT INTO borrows (user_id, book_id, due_date, ...)
activate db
db --> model : 保存完了
deactivate db
model --> flask : Borrowオブジェクト
deactivate model

flask -> ui : redirect(url_for('borrows.borrows_active_list'))
ui --> user : 貸出中一覧へリダイレクト
deactivate flask

@enduml
