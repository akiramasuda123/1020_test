@startuml 利用者の削除
autonumber
title 利用者の削除 (POST /users/users_list/<id>/delete)

actor 管理者 as user
boundary "users/list.html" as ui
control "users/views.py" as flask
entity "User\n(models.py)" as model
database "SQLite\n(users)" as db

user -> ui : 「削除」ボタンをクリック
ui -> flask : POST /users/users_list/<id>/delete
activate flask

flask -> model : User.query.get_or_404(id)
activate model
model -> db : SELECT * FROM users WHERE user_id = ?
activate db
db --> model : レコード返却
deactivate db
model --> flask : Userオブジェクト
deactivate model

flask -> model : db.session.delete(user)\ndb.session.commit()
activate model
model -> db : DELETE FROM users WHERE user_id = ?
activate db
db --> model : 削除完了
deactivate db
model --> flask : 完了
deactivate model

flask -> ui : redirect(url_for('users.users_list'))
ui --> user : 利用者一覧画面へリダイレクト\n(「{利用者名}を削除しました」表示)
deactivate flask

@enduml
