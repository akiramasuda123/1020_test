@startuml 本の編集
autonumber
title 本の編集 (GET・POST /books/books_list/<id>/update)

actor 管理者 as user
boundary "books/update.html" as ui
control "books/views.py" as flask
entity "Book / BookGenre\n(models.py)" as model
database "SQLite\n(books / book_genres)" as db

== フォーム表示 ==
user -> ui : 「編集」ボタンをクリック
ui -> flask : GET /books/books_list/<id>/update
activate flask

flask -> model : Book.query.get_or_404(id)
activate model
model -> db : SELECT * FROM books WHERE book_id = ?
activate db
db --> model : レコード返却
deactivate db
model --> flask : Bookオブジェクト
deactivate model

flask -> model : BookGenre.query.all()
activate model
model -> db : SELECT * FROM book_genres
activate db
db --> model : レコード一覧返却
deactivate db
model --> flask : BookGenreオブジェクトのリスト
deactivate model

flask -> ui : render_template('books/update.html', form=form)\n※既存データをformにセット
ui --> user : 既存データが入った編集フォーム表示
deactivate flask

== 更新処理 ==
user -> ui : 変更を入力し「更新」ボタンをクリック
ui -> flask : POST /books/books_list/<id>/update
activate flask

flask -> model : book.title = ...\nbook.author = ...\nbook.genre_id = ...\nbook.stock = ...
activate model
model -> db : db.session.commit()
activate db
db --> model : 更新完了
deactivate db
model --> flask : 更新済みBookオブジェクト
deactivate model

flask -> ui : redirect(url_for('books.books_list'))
ui --> user : 本の一覧画面へリダイレクト
deactivate flask

@enduml
