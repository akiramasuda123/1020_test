@startuml ジャンルの編集
autonumber
title ジャンルの編集 (GET・POST /book_genres/book_genres_list/<id>/update)

actor 管理者 as user
boundary "book_genres/update.html" as ui
control "book_genres/views.py" as flask
entity "BookGenre\n(models.py)" as model
database "SQLite\n(book_genres)" as db

== フォーム表示 ==
user -> ui : 「編集」ボタンをクリック
ui -> flask : GET /book_genres/book_genres_list/<id>/update
activate flask

flask -> model : BookGenre.query.get_or_404(id)
activate model
model -> db : SELECT * FROM book_genres WHERE genre_id = ?
activate db
db --> model : レコード返却
deactivate db
model --> flask : BookGenreオブジェクト
deactivate model

flask -> ui : render_template('book_genres/update.html', form=form)\n※既存データをformにセット
ui --> user : 既存データが入った編集フォーム表示
deactivate flask

== 更新処理 ==
user -> ui : ジャンル名を変更し「更新」ボタンをクリック
ui -> flask : POST /book_genres/book_genres_list/<id>/update
activate flask

flask -> model : book_genre.genre_name = ...
activate model
model -> db : db.session.commit()
activate db
db --> model : 更新完了
deactivate db
model --> flask : 更新済みBookGenreオブジェクト
deactivate model

flask -> ui : redirect(url_for('book_genres.book_genres_list'))
ui --> user : ジャンル一覧画面へリダイレクト
deactivate flask

@enduml
