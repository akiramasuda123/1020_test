@startuml 本の新規登録
autonumber
title 本の新規登録 (GET・POST /books/books_new)

actor 管理者 as user
boundary "books/new.html" as ui
control "books/views.py" as flask
entity "Book / BookGenre\n(models.py)" as model
database "SQLite\n(books / book_genres)" as db

== フォーム表示 ==
user -> ui : 「新規登録」リンクをクリック
ui -> flask : GET /books/books_new
activate flask

flask -> model : BookGenre.query.all()
activate model
model -> db : SELECT * FROM book_genres
activate db
db --> model : レコード一覧返却
deactivate db
model --> flask : BookGenreオブジェクトのリスト
deactivate model

flask -> ui : render_template('books/new.html', form=form)\n※ジャンル選択肢をformにセット
ui --> user : 登録フォーム表示（ジャンル選択肢付き）
deactivate flask

== 登録処理 ==
user -> ui : タイトル・著者・ジャンル・在庫を入力し「登録」
ui -> flask : POST /books/books_new
activate flask

flask -> model : Book(title, author, genre_id, stock)
activate model
model -> db : db.session.add(book)\ndb.session.commit()
activate db
db --> model : 保存完了
deactivate db
model --> flask : Bookオブジェクト
deactivate model

flask -> ui : redirect(url_for('books.books_list'))
ui --> user : 本の一覧画面へリダイレクト
deactivate flask

@enduml
