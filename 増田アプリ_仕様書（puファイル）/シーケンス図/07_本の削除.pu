@startuml 本の削除
autonumber
title 本の削除 (POST /books/books_list/<id>/delete)

actor 管理者 as user
boundary "books/list.html" as ui
control "books/views.py" as flask
entity "Book\n(models.py)" as model
database "SQLite\n(books)" as db

user -> ui : 「削除」ボタンをクリック
ui -> flask : POST /books/books_list/<id>/delete
activate flask

flask -> model : Book.query.get_or_404(id)
activate model
model -> db : SELECT * FROM books WHERE book_id = ?
activate db
db --> model : レコード返却
deactivate db
model --> flask : Bookオブジェクト
deactivate model

flask -> model : db.session.delete(book)\ndb.session.commit()
activate model
model -> db : DELETE FROM books WHERE book_id = ?
activate db
db --> model : 削除完了
deactivate db
model --> flask : 完了
deactivate model

flask -> ui : redirect(url_for('books.books_list'))
ui --> user : 本の一覧画面へリダイレクト\n(「{タイトル}を削除しました」表示)
deactivate flask

@enduml
